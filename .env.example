# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
# Replace both placeholder values with long, unique random strings.

SECRET_KEY=replace-with-a-long-random-secret-key
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret

# Optional backend settings
APP_ENV=development
FLASK_DEBUG=false
USE_GPU=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
FORCE_HTTPS=false

# This legacy local-only reset flow is disabled automatically in production.
# Add an emailed reset-token flow before making public accounts available.
ALLOW_INSECURE_PASSWORD_RESET=true
# Docker Compose sets REDIS_URL automatically. In AWS use the ElastiCache URL:
# REDIS_URL=redis://your-elasticache-host:6379/0

# Password reset: local development prints the reset link in backend logs.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_CONSOLE=true
# In production set PASSWORD_RESET_CONSOLE=false and configure SMTP / AWS SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# PostgreSQL used by Docker Compose. Use URL-safe values (for example, values
# generated with `openssl rand -hex 32`) because the password is part of a URL.
POSTGRES_DB=water_monitoring
POSTGRES_USER=water_monitoring
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Leave unset for the local Docker PostgreSQL service. In AWS, set this to the
# complete RDS URL, including `?sslmode=require`.
# DATABASE_URL=postgresql+psycopg://user:password@rds-host:5432/database?sslmode=require

# Optional: path to a labeled potability dataset used only by the retraining script.
# POTABILITY_DATASET=/app/water_potability.csv
